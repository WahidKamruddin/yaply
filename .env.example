VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# GIF picker (paperclip → GIF tab). Create an app at https://developers.giphy.com/dashboard/
# to get a key. Leave as-is to disable GIF search (the picker shows a config hint).
VITE_GIPHY_API_KEY=your-giphy-api-key

# Set to "true" to skip Supabase auth entirely during local development.
# Uses a hardcoded dev user (id: dev-user-00000000-..., email: dev@localhost).
# Never set this in production.
VITE_DEV_BYPASS_AUTH=false

# Set to "true" to require a passcode screen before the app loads (before
# even the login screen). Staging-only — set this ONLY on the staging
# Netlify site's env vars, never on production. See CLAUDE.md.
VITE_STAGING_GATE=false
